# Copy to .env.local (git-ignored) and fill in. Never commit real credentials.
# DATABASE_URL is read only on the server and by `npm run db:*`. Never expose it
# through a NEXT_PUBLIC_ variable.

# "demo" (default when unset) reads the in-process demo book.
# "database" reads PostgreSQL and fails visibly if DATABASE_URL is missing,
# unreachable or unmigrated. It never falls back to demo data.
OMEN_STORAGE_MODE=demo

# Local, disposable PostgreSQL only. Placeholders, not working credentials.
DATABASE_URL=postgres://omen_local:change-me@127.0.0.1:5432/omen_dev

# Integration tests create and drop a throwaway database through this
# maintenance connection. The role needs CREATEDB. Point it at a local server.
OMEN_TEST_DATABASE_ADMIN_URL=postgres://omen_local:change-me@127.0.0.1:5432/postgres
