{
  "$schema": "OMEN design tokens — mirrors css/tokens.css; base values come from the workspace prototype (omen.html)",
  "color": {
    "surface": { "bg-0": "#0C0E11", "bg-1": "#111418", "bg-2": "#161A1F", "bg-3": "#1C2127", "black": "#000000" },
    "border": { "border-0": "rgba(255,255,255,0.055)", "border-1": "rgba(255,255,255,0.09)", "border-2": "rgba(255,255,255,0.14)", "border-focus": "rgba(129,148,255,0.55)" },
    "text": { "tx-0": "#E7E9EC", "tx-1": "#9BA3AD", "tx-2": "#5E6670" },
    "accent": { "ac": "#8194FF", "ac-dim": "rgba(129,148,255,0.13)", "ac-line": "rgba(129,148,255,0.35)" },
    "semantic": { "up": "#6FAE8F", "up-dim": "rgba(111,174,143,0.12)", "dn": "#C08383", "dn-dim": "rgba(192,131,131,0.12)", "warn": "#C9A96A" },
    "brand-silver": { "silver-0": "#F2F1EC", "silver-1": "#B9B6AE", "silver-2": "#6E6C66" },
    "spectrum": {
      "note": "Atmospheric sections only. Hue/saturation are functions of horizontal position, sampled from the reference recording.",
      "hue-stops-deg": [[0, 15], [0.10, 355], [0.20, 300], [0.30, 255], [0.40, 238], [0.50, 222], [0.60, 203], [0.70, 193], [0.78, 168], [0.83, 134], [0.88, 65], [0.95, 57], [1.0, 55]],
      "saturation-stops": [[0, 0.80], [0.12, 0.74], [0.22, 0.68], [0.32, 0.74], [0.50, 0.86], [0.62, 0.86], [0.74, 0.84], [0.82, 0.70], [0.90, 0.64], [1.0, 0.66]],
      "base-lightness": 0.52,
      "fades-to": "#000000"
    }
  },
  "typography": {
    "families": { "sans": "Inter (variable, 100–900)", "mono": "IBM Plex Mono 400/500" },
    "base": { "html-font-size": "15px", "body-weight": 450, "body-letter-spacing": "0.005em", "line-height": 1.5 },
    "scale": {
      "hero-h1": "clamp(40px, 6.2vw, 76px) / 550 / -0.03em / 1.02",
      "final-h2": "clamp(30px, 4vw, 48px) / 550 / -0.025em / 1.08",
      "section-h2": "clamp(26px, 3vw, 36px) / 550 / -0.02em / 1.15",
      "feature-h2": "clamp(24px, 2.6vw, 32px) / 550 / -0.02em / 1.15",
      "card-title": "17px / 550 / -0.01em",
      "step-h3": "15px / 550", "lead": "16px / tx-1 / 1.6", "body": "13.5–14.5px", "small": "12–12.5px", "micro": "11–11.5px",
      "prob-xl": "Plex Mono clamp(44px, 5vw, 64px) / 500 / -0.03em / tnum; decimal+% at 0.5em in tx-1",
      "prob-md": "Plex Mono 20px / 500 / tnum", "move": "Plex Mono 14px / 500 / tnum", "stamp": "Plex Mono 12px / tx-2 / tnum",
      "wordmark": "Inter 550, letter-spacing 0.22em (topbar 13px) / 0.26em (footer 30px)"
    }
  },
  "radius": { "r-1": "3px", "r-2": "6px", "r-3": "9px", "r-4": "14px" },
  "space": { "sp-1": "4px", "sp-2": "8px", "sp-3": "12px", "sp-4": "16px", "sp-5": "24px", "sp-6": "32px", "sp-7": "48px", "sp-8": "72px", "sp-9": "112px" },
  "layout": { "max-w": "1180px", "gutter": "clamp(20px, 4vw, 48px)", "topbar-h": "56px", "breakpoints": { "stack-columns": "980px", "mobile": "720px" }, "event-card-container-stack": "720px (container query on .panel)" },
  "motion": { "t-fast": "120ms", "t-med": "200ms", "t-slow": "360ms", "ease": "cubic-bezier(.3,.7,.4,1)", "spectrum-period": "7s", "spectrum-fps-cap": 30 },
  "assets": {
    "omen-symbol": "assets/omen-symbol.png — 1024×1024 RGBA, supplied, unchanged. Visible symbol occupies alpha box 586×820 (x 218–804, y 102–922); always display with object-fit: contain and set height only.",
    "fonts": ["assets/fonts/inter-latin-wght-normal.woff2", "assets/fonts/ibm-plex-mono-latin-400-normal.woff2", "assets/fonts/ibm-plex-mono-latin-500-normal.woff2"]
  }
}
